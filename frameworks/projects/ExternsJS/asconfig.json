 {
    "config": "royale",
    "type": "lib",
    "compilerOptions": {
        "debug": true,
        "targets": [
            "SWF",
            "JSRoyale"
        ],
		"namespace": [
			{
				"uri": "library://ns.apache.org/royale/externsjs",
				"manifest": "src/main/resources/externsjs-manifest.xml"
			}
		],
        "include-namespaces": [
            "library://ns.apache.org/royale/externsjs"
        ],
        "include-classes": [
            "src/main/royale/ExternsJSClasses.as"
        ],
        "source-path": [
            "src/main/royale"
        ],
        "library-path": [
            "${royalelib}/libs/MXRoyaleBase.swc"
        ],
        "js-library-path": [
            "${royalelib}/js/libs/MXRoyaleBaseJS.swc"
        ],
        "output": "target/ExternsJS.swc"
    },
    "additionalOptions": [
		"-js-include-css+=src/main/assembly/third-party/inspiretree/7.0.16/inspire-tree-community.min.css"
    ]
}
